# Pomo firmware defaults. sdkconfig is generated from this file and is not committed.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

# Bluetooth: Bluedroid, Classic only (SPP to the laptop), no BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n

# Wi-Fi (ESP-NOW only) alongside BT
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Touch: touch.c calibrates the raw ADC readings itself
CONFIG_XPT2046_CONVERT_ADC_TO_COORDS=n

# LVGL
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_DEMO_WIDGETS=n
# LVGL allocates from the system heap instead of a fixed private pool: the Focus screen alone
# needs ~36 KB of objects, and a static pool would also take DRAM away from BT and Wi-Fi
CONFIG_LV_USE_CLIB_MALLOC=y

# Freeze checks: a stuck UI reboots with an explanation instead of freezing silently
# - LVGL asserts abort (main/lvgl_hooks/pomo_lv_assert.h) instead of spinning forever
# - LVGL warnings, like a failed allocation, go to the serial log
# - the task watchdog panics when a task hogs a CPU for 5 s (it only printed before)
# - on any panic, a core dump of every task goes to the serial monitor, which decodes it
CONFIG_LV_ASSERT_HANDLER_INCLUDE="pomo_lv_assert.h"
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
